{
  "name": "dsh-mlx-local",
  "description": "在 Apple Silicon 上用 MLX 框架运行本地大模型:模型目录管理、服务启停、OpenAI 兼容 API,并优化 DSH 自定义提供方的本地思考强度选择。",
  "version": "0.2.2",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "mlx",
    "mlx-lm",
    "local-llm",
    "apple-silicon"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/stream.js && node --check lib/client.js && node --check dsh-mlx-local.dyn.js",
    "test": "node --test test/*.test.mjs",
    "pack": "npm run check && npm test && npm pack"
  },
  "files": [
    "lib",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "cordis.patch.yml",
    "dsh-mlx-local.dyn.js"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-timeout": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./dyn": {
      "default": "./dsh-mlx-local.dyn.js"
    },
    "./package.json": "./package.json"
  }
}
